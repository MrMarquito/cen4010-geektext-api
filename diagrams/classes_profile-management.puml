@startuml
skinparam classAttributeIconSize 0

package "Database Models (SQLAlchemy)" {
    class User {
        +username : String(100) [PK]
        +password : String(100)
        +name : String(100)
        +email : String(100)
        +address : String(100)
        --
        +verify_password(plain_password: str) : bool
        +update_fields(fields: dict) : void
        +to_dict() : dict
    }

    class CreditCard {
        +id : Integer [PK]
        +username : String(100) [FK]
        +number : String(16)
        +exp : String(7)
        +cvv : String(4)
        --
        +mask_card_number() : str
        +is_expired() : bool
        +to_dict() : dict
    }

    User "1" *-- "0..*" CreditCard : owns >
}

package "Validation Schemas (Pydantic)" {
    class UserCreate {
        +username : str
        +password : str
        +name : str | None
        +email : str | None
        +address : str | None
        --
        +validate_password(password: str) : str
        +model_dump() : dict
    }

    class UserUpdate {
        +password : str | None
        +name : str | None
        +address : str | None
        --
        +has_updates() : bool
        +model_dump(exclude_unset: bool) : dict
    }

    class UserResponse {
        +username : str
        +name : str | None
        +email : str | None
        +address : str | None
        --
        +from_orm(user_model: User) : UserResponse
        +model_dump() : dict
    }

    class CreditCardCreate {
        +number : str
        +exp : str
        +cvv : str
        --
        +validate_card_number(number: str) : str
        +validate_exp(exp: str) : str
        +model_dump() : dict
    }
}

' Conceptual dependencies between API schemas and DB models
UserCreate ..> User : creates >
UserUpdate ..> User : updates >
User ..> UserResponse : serializes to >
CreditCardCreate ..> CreditCard : creates >

@enduml
